{
  "tasks": {
    "dev": "deno run -A --allow-scripts npm:vite",
    "build": "deno run -A --allow-scripts npm:vite build",
    "preview": "deno run -A --allow-scripts npm:vite preview",
    "check": "deno check --sloppy-imports src/main.tsx",
    "lint": "deno lint",
    "fmt": "deno fmt"
  },
  "nodeModulesDir": "auto",
  "imports": {
    "@/": "./src/"
  },
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "strict": true,
    "lib": ["dom", "dom.iterable", "esnext"]
  }
}
