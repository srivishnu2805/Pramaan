# Copy to .env and adjust. Never commit .env.
PRAMAAN_DATABASE_URL=postgresql+asyncpg://pramaan_admin:secure@localhost:5432/pramaan_db
# Generate: uv run python -c "import secrets; print(secrets.token_hex(32))"
PRAMAAN_JWT_SECRET=change-me
# DEV-ONLY AES-256 root key for envelope encryption (never a production KMS).
PRAMAAN_KMS_ROOT_KEY_HEX=change-me
# Must be false in production. Only enables external AI for dev demos.
PRAMAAN_ALLOW_EXTERNAL_AI=false
PRAMAAN_OPENAI_API_KEY=
